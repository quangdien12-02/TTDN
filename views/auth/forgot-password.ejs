<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Quên mật khẩu | RBC HRM</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/public/css/style.css" rel="stylesheet" />
    <link href="/public/css/captcha.css" rel="stylesheet" />
  </head>
  <body class="login-page">
    <div class="login-shell">
      <div class="login-brand">
        <div class="brand-mark">R</div>
        <div>
          <h1>RBC <span>HRM</span></h1>
          <p>Hệ thống quản lý nhân sự doanh nghiệp</p>
        </div>
      </div>
      <div class="login-card">
        <h2>Quên mật khẩu</h2>
        <p class="text-secondary mb-4">
          Gửi yêu cầu để quản trị viên hỗ trợ đặt lại mật khẩu.
        </p>
        <% if(error){ %>
        <div class="alert alert-danger"><%= error %></div>
        <% } %><% if(message){ %>
        <div class="alert alert-info"><%= message %></div>
        <% } %>
        <form method="post" action="/forgot-password">
          <div class="mb-3">
            <label class="form-label" for="username">Tên đăng nhập</label
            ><input
              class="form-control form-control-lg"
              id="username"
              name="username"
              autocomplete="username"
              required
              autofocus
            />
          </div>
          <div class="mb-4">
            <div class="captcha-heading">
              <label class="form-label mb-0" for="captcha"
                >Nhập các ký tự trong ảnh</label
              ><button
                class="captcha-refresh"
                type="button"
                data-captcha-refresh="forgot-captcha"
                data-captcha-scope="forgot"
                aria-label="Làm mới mã CAPTCHA"
              >
                ↻ Đổi mã
              </button>
            </div>
            <img
              class="captcha-image"
              id="forgot-captcha"
              src="/captcha.svg?scope=forgot"
              alt="Mã xác nhận gồm 5 ký tự"
            /><input
              class="form-control form-control-lg mt-2"
              id="captcha"
              name="captcha"
              maxlength="5"
              autocapitalize="characters"
              autocomplete="off"
              required
            /><span class="captcha-feedback" aria-live="polite"></span>
          </div>
          <button class="btn btn-primary btn-lg w-100">Gửi yêu cầu</button>
        </form>
        <div class="text-end mt-3">
          <a href="/login">← Quay lại đăng nhập</a>
        </div>
      </div>
      <p class="login-foot">© RBC HRM · Giao diện phục vụ đồ án thực tập</p>
    </div>
    <script src="/public/js/app.js"></script>
  </body>
</html>
