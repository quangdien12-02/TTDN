<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> | RBC HRM</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="/public/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <% if (user) { %>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
      <div class="container-fluid px-lg-4">
        <a class="navbar-brand fw-bold" href="/"
          >RBC <span class="brand-light">HRM</span></a
        >
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link <%= currentPath==='/'?'active':'' %>" href="/"
                >Tổng quan</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/employees">Nhân viên</a>
            </li>
            <% if(user.role==='admin'){ %>
            <li class="nav-item">
              <a class="nav-link" href="/departments">Phòng ban</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/positions">Chức vụ</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/contracts">Hợp đồng</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/accounts">Tài khoản</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/accounts/reset-requests"
                >Yêu cầu đặt lại mật khẩu</a
              >
            </li>
            <% } %>
          </ul>
          <div class="d-flex align-items-center gap-3 text-white">
            <span class="small"
              ><%= user.username %> · <%= user.role==='admin'?'Quản trị viên':'Nhân viên' %></span
            >
            <form method="post" action="/logout">
              <button class="btn btn-sm btn-outline-light">Đăng xuất</button>
            </form>
          </div>
        </div>
      </div>
    </nav>
    <% } %>
    <main class="container-fluid px-3 px-lg-4 py-4">
      <% if (flash) { %>
      <div
        class="alert alert-<%= flash.type %> alert-dismissible fade show"
        role="alert"
      >
        <%= flash.message %><button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
        ></button>
      </div>
      <% } %>
    </main>
  </body>
</html>
